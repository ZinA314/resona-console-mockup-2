# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 남깁니다. 채울 값이 무엇인지 알려 주는 자리입니다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 이슈 관련 스크립트 (로컬 도구)
/issues/create-issues*.sh
/issues/sync-issues.sh
# 개발 검증용 음원 (상업 음원 포함 — 절대 올리지 않습니다)
/public/_devaudio/
